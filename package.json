{
  "name": "talentbd-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TalentBD 2026: The ultimate Ed-Tech & Fintech Hybrid Platform.",
  "main": "index.js",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "install-all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "dev": "concurrently -n \"Frontend,Backend\" -c \"blue,green\" \"npm run frontend\" \"npm run backend\"",
    "frontend": "npm run start --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "start": "react-scripts start",
    "build": "npm run build --prefix frontend",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "framer-motion": "^12.29.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-scripts": "^5.0.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "wait-on": "^7.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheam274/talent-bd.git"
  },
  "author": "Sheam",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sheam274/talent-bd/issues"
  },
  "homepage": "https://github.com/sheam274/talent-bd#readme",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
